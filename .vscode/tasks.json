{
    // Shared VS Code tasks for the game_engine project.
    // Trigger via Ctrl+Shift+P -> "Tasks: Run Task", or the default
    // build/test tasks via Ctrl+Shift+B / Ctrl+Shift+T (Cmd on macOS).
    //
    // We use `type: shell` (rather than `type: cargo`) so the tasks
    // work even if a developer hasn't installed the rust-analyzer
    // extension's task provider. Plain `cargo` is on PATH after rustup.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "fmt",
            "detail": "Apply rustfmt to all source files.",
            "type": "shell",
            "command": "cargo fmt --all",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "fmt:check",
            "detail": "Verify formatting without writing changes (CI-friendly).",
            "type": "shell",
            "command": "cargo fmt --all -- --check",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "lint",
            "detail": "Run clippy with our pedantic config and fail on any warning.",
            "type": "shell",
            "command": "cargo clippy --all-targets -- -D warnings",
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "check",
            "detail": "Type-check only (fast, no link). Default build task.",
            "type": "shell",
            "command": "cargo check --all-targets",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "test",
            "detail": "Run unit + integration tests. Default test task.",
            "type": "shell",
            "command": "cargo test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run",
            "detail": "Build and run the engine with verbose wgpu logs.",
            "type": "shell",
            "command": "cargo run",
            "options": {
                "env": {
                    "RUST_LOG": "wgpu=warn,info"
                }
            },
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "ci",
            "detail": "Format-check + clippy + test — what CI would run.",
            "dependsOn": [
                "fmt:check",
                "lint",
                "test"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
